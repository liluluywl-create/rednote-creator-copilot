# Public template only. Never put real credentials in this file.
# Fill the local .env.local file instead; all .env* files are ignored by Git.
# These VOLC_* names are project conventions, not automatically loaded SDK settings.

# Required: an inference API Key from the Volcengine Ark console (not AK/SK).
VOLC_API_KEY=

# Standard Ark inference service, Beijing region; not the Coding Plan endpoint.
VOLC_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Required: the exact model identifier from your enabled vision model's console example.
# A supported Model ID or an ep-... Endpoint ID occupies this one field.
# Do not also configure VOLC_ENDPOINT_ID; the future runner will use VOLC_MODEL_ID.
VOLC_MODEL_ID=
